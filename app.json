{
  "expo": {
    "name": "SwiftBets",
    "slug": "swiftbets",
    "scheme": "swiftbets",
    "version": "0.2.0",
    "orientation": "default",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "dark",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0b1220"
    },
    "android": {
      "package": "com.remonenaidoo.swiftbets",
      "versionCode": 1,
      "adaptiveIcon": {
        "foregroundImage": "./assets/android-icon-foreground.png",
        "monochromeImage": "./assets/android-icon-monochrome.png",
        "backgroundColor": "#0b1220"
      },
      "allowBackup": false
    },
    "plugins": [
      "expo-router",
      "expo-secure-store",
      "expo-web-browser",
      "expo-notifications"
    ],
    "web": {
      "bundler": "metro",
      "output": "single",
      "favicon": "./assets/favicon.png",
      "name": "SwiftBets",
      "themeColor": "#0b1220",
      "backgroundColor": "#0b1220"
    },
    "extra": {
      "apiBaseUrl": "https://swiftbets.swiftsoftwaresystems.co.za"
    }
  }
}
